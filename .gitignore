.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.venv/
.usehbn/
.hbn/manifest.json
.hbn/state.json
.hbn/readbacks/
.hbn/results/*
# Preserve cross-IA review evidence (audit-permanent), keep runtime ERPs ignored
!.hbn/results/*-cross-ia-*
# ADR-025 (onda 0006 I-03): resultado governado no formato carimbo
# AAAAMMDD-HHMMSS-<agente>-<slug> NUNCA fica invisível ao git
!.hbn/results/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*
dist/
build/
logs/*.json
state/*.json

# Claude Code local-only settings (per-developer, do not commit)
.claude/settings.local.json

# junk macOS/Office
.DS_Store
~$*
